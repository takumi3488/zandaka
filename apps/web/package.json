    "@orpc/zod": "catalog:",
    "@solidjs/meta": "1.0.0-next.2",
    "@solidjs/router": "2.0.0-next.42",
    "@solidjs/web": "2.0.0-rc.18",
    "@tanstack/query-core": "5.105.0",
    "@tanstack/solid-query": "6.0.0-rc.5",
    "@zandaka/api": "workspace:*",
    "@zandaka/db": "workspace:*",
    "libsql": "catalog:",
    "solid-js": "2.0.0-rc.18",
    "varlock": "catalog:",
    "vite-plugin-pwa": "^2.0.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@solidjs/vite-plugin": "3.0.0-next.51",
